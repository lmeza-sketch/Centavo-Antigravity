# Variables de entorno — Centavo Monorepo
# Copia este archivo como .env y ajusta los valores para tu entorno local.

# ─── auth-service (puerto 4001) ───────────────────────────────────────────────
AUTH_PORT=4001
AUTH_DATABASE_URL=postgresql://centavo:centavo@localhost:5432/centavo_auth
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── transactions-service (puerto 4002) ───────────────────────────────────────
TXN_PORT=4002
TXN_DATABASE_URL=postgresql://centavo:centavo@localhost:5432/centavo_transactions

# ─── budgets-service (puerto 4003) ────────────────────────────────────────────
BDG_PORT=4003
BDG_DATABASE_URL=postgresql://centavo:centavo@localhost:5432/centavo_budgets

# ─── notifications-service (puerto 4004) ──────────────────────────────────────
NOT_PORT=4004
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@centavo.app
SMTP_PASS=your-smtp-password
FCM_SERVER_KEY=your-fcm-server-key

# ─── reports-service (puerto 4005) ────────────────────────────────────────────
RPT_PORT=4005
RPT_DATABASE_URL=postgresql://centavo:centavo@localhost:5432/centavo_reports
REPORT_CRON_SCHEDULE="0 8 1 * *"

# ─── Message Broker ───────────────────────────────────────────────────────────
BROKER_URL=amqp://localhost:5672

# ─── Frontend (puerto 3000) ───────────────────────────────────────────────────
VITE_AUTH_SERVICE_URL=http://localhost:4001
VITE_TRANSACTIONS_SERVICE_URL=http://localhost:4002
VITE_BUDGETS_SERVICE_URL=http://localhost:4003
VITE_NOTIFICATIONS_SERVICE_URL=http://localhost:4004
VITE_REPORTS_SERVICE_URL=http://localhost:4005
